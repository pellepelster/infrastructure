# Managed by ansible (roles/contact) - local changes will be overwritten.
[Unit]
Description=solidblocks contact backend
Wants=network-online.target
After=network-online.target

[Container]
Image={{ contact_image }}
EnvironmentFile={{ contact_env_file }}
PublishPort={{ contact_bind_address }}:{{ contact_port }}:8080
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
UserNS=auto

[Service]
Restart=always

[Install]
WantedBy=multi-user.target

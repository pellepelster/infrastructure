locals {
  ansible_dir = abspath("${path.module}/../../.ansible")
}

resource "local_file" "ansible_inventory" {
  filename             = "${local.ansible_dir}/inventory.yml"
  file_permission      = "0644"
  directory_permission = "0755"
  content = <<-EOT
    # Generated by terraform (terraform/www-public/ansible.tf) - do not edit.
    www_public:
      hosts:
        ${hcloud_server.www_public.name}:
          ansible_host: ${hcloud_server.www_public.name}
          ansible_ssh_common_args: "-F ${local.ssh_dir}/config"
          www_public_sites: ${jsonencode([
  for site, config in var.sites : {
    name    = site
    domains = concat([site], config.domains)
  }
])}
          storage_device: "${hcloud_volume.www_public.linux_device}"
  EOT
}
